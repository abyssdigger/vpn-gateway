{
  "schema": "vpng-command-aliases/2",
  "matching": {
    "full_input_only": true,
    "full_input_only_scope": "alias_segment",
    "trim_outer_whitespace": true,
    "collapse_internal_whitespace": true,
    "case_insensitive_keywords_and_units": true,
    "unknown_text_is_not_ignored": true,
    "composition": {
      "allowed_envelopes": [
        "<alias>",
        "<prelude>. <alias>",
        "<alias>: <conditions>",
        "<prelude>. <alias>: <conditions>"
      ],
      "prelude_separator": ".",
      "prelude_semantics": "execute_before_alias_activation",
      "conditions_separator": ":",
      "conditions_semantics": "additional_execution_conditions_for_canonical_intent",
      "allow_combined": true,
      "alias_segment_must_match_registered_pattern_completely": true,
      "alias_segment_must_be_final_alias_segment": true,
      "arbitrary_substring_matching": false
    }
  },
  "types": {
    "duration": {
      "number": "positive_integer",
      "unit_optional": true,
      "default_unit": "minute",
      "allow_whitespace_before_unit": true,
      "canonical_output": "seconds",
      "units": {
        "second": {
          "seconds": 1,
          "forms": [
            "s",
            "sec",
            "secs",
            "second",
            "seconds",
            "с",
            "сек",
            "секунда",
            "секунды",
            "секунд"
          ]
        },
        "minute": {
          "seconds": 60,
          "forms": [
            "m",
            "min",
            "mins",
            "minute",
            "minutes",
            "м",
            "мин",
            "минута",
            "минуты",
            "минут"
          ]
        },
        "hour": {
          "seconds": 3600,
          "forms": [
            "h",
            "hr",
            "hrs",
            "hour",
            "hours",
            "ч",
            "час",
            "часа",
            "часов"
          ]
        },
        "day": {
          "seconds": 86400,
          "forms": [
            "d",
            "day",
            "days",
            "д",
            "день",
            "дня",
            "дней"
          ]
        },
        "week": {
          "seconds": 604800,
          "forms": [
            "w",
            "wk",
            "wks",
            "week",
            "weeks",
            "нед",
            "неделя",
            "недели",
            "недель"
          ]
        }
      }
    },
    "iteration_count": {
      "number": "positive_integer",
      "canonical_output": "integer"
    }
  },
  "aliases": [
    {
      "id": "start-cdc-with-collab",
      "patterns": [
        "коллаб {duration}",
        "collab {duration}"
      ],
      "parameters": {
        "duration": {
          "type": "duration"
        }
      },
      "canonical_intent": {
        "action": "start_new_cdc_with_collab",
        "duration_seconds": "{duration}",
        "entrypoint": "EXECUTION-LOOP.md#START",
        "overlays": [
          "CONTINUOUS-DEVELOPMENT.md",
          "COLLABORATIVE-EXECUTION.md"
        ],
        "direct_overlay_entry_forbidden": true
      },
      "equivalent_explicit_request": "Start a new {duration} CDC+COLLAB cycle. Enter only through `EXECUTION-LOOP.md` -> `START`. Do not enter through `CONTINUOUS-DEVELOPMENT.md` or `COLLABORATIVE-EXECUTION.md` directly. Follow `START` exactly."
    },
    {
      "id": "start-cdc-with-collab-iteration-budget",
      "patterns": [
        "коллаб {iterations}/{duration}",
        "collab {iterations}/{duration}"
      ],
      "parameters": {
        "iterations": {
          "type": "iteration_count"
        },
        "duration": {
          "type": "duration"
        }
      },
      "canonical_intent": {
        "action": "start_new_cdc_with_collab",
        "iteration_budget": "{iterations}",
        "duration_seconds": "{duration}",
        "entrypoint": "EXECUTION-LOOP.md#START",
        "overlays": [
          "CONTINUOUS-DEVELOPMENT.md",
          "COLLABORATIVE-EXECUTION.md"
        ],
        "direct_overlay_entry_forbidden": true
      },
      "equivalent_explicit_request": "Start a new CDC+COLLAB cycle with at most {iterations} WORK/WAIT iterations and maximum wall-clock duration {duration}. Enter only through `EXECUTION-LOOP.md` -> `START`. Stop at whichever limit is reached first. Do not enter through `CONTINUOUS-DEVELOPMENT.md` or `COLLABORATIVE-EXECUTION.md` directly. Follow `START` exactly."
    }
  ]
}
