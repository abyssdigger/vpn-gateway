[Unit]
Description=VPN-GATE NG3 first alpha controller
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
Environment=PYTHONPATH=/usr/lib/vpn-gate-alpha
ExecStart=/usr/bin/python3 -m rou.alpha_runtime --config /etc/vpn-gate-alpha/config.toml
RuntimeDirectory=vpn-gate-alpha
RuntimeDirectoryMode=0700
Restart=no
KillMode=control-group
TimeoutStartSec=30
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
